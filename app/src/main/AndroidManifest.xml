<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-permission android:name="android.permission.INTERNET"/>
 <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
 <queries>
  <package android:name="com.schiwy.carservice"/><package android:name="com.schiwy.haushaltsbuch"/>
  <package android:name="com.schiwy.arbeitszeit"/><package android:name="com.schiwy.galeriesync"/>
  <package android:name="com.schiwy.vertraege"/><package android:name="com.schiwy.rauchfrei"/>
  <package android:name="com.schiwy.ironlog"/>
 </queries>
 <application android:label="MyAppHub+" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:usesCleartextTraffic="false" android:allowBackup="false">
  <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.files" android:exported="false" android:grantUriPermissions="true">
   <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths"/>
